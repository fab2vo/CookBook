<?xml version="1.0" encoding="utf-8"?>
<!-- Fenêtre d'ajout / modification d'un plat de l'agenda -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp">

    <!-- Date et repas : visibles seulement en modification -->
    <LinearLayout
        android:id="@+id/agenda_move_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/agenda_date_button"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <RadioGroup
            android:id="@+id/agenda_meal_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/agenda_meal_lunch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/PAG_lunch" />

            <RadioButton
                android:id="@+id/agenda_meal_dinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/PAG_dinner" />
        </RadioGroup>
    </LinearLayout>

    <RadioGroup
        android:id="@+id/agenda_kind_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/agenda_kind_recipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/PAG_from_cookbook" />

        <RadioButton
            android:id="@+id/agenda_kind_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/PAG_free_text" />
    </RadioGroup>

    <AutoCompleteTextView
        android:id="@+id/agenda_recipe_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:completionThreshold="1"
        android:hint="@string/PAG_recipe_hint"
        android:inputType="text"
        android:maxLines="1" />

    <EditText
        android:id="@+id/agenda_text_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/PAG_text_hint"
        android:inputType="textCapSentences"
        android:maxLength="255"
        android:maxLines="2" />
</LinearLayout>
